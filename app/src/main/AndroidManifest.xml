<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        自定义权限：允许授权应用控制 Mirage 配置（重载配置、清除缓存等）。
    -->
    <permission
        android:name="wx.mirage.permission.CONTROL"
        android:protectionLevel="signature"
        android:label="@string/permission_control_label"
        android:description="@string/permission_control_desc" />
    <uses-permission android:name="wx.mirage.permission.CONTROL" />

    <application
        android:name=".wxmask.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaskWechat"
        tools:targetApi="31">

        <!-- ===== Mirage 管理界面 ===== -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.MainActivity">
            <intent-filter>
                <action android:name="wx.mirage.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.ConfigReceiver"
            android:exported="true"
            android:permission="wx.mirage.permission.CONTROL">
            <intent-filter>
                <action android:name="wx.mirage.action.RELOAD_CONFIG" />
                <action android:name="wx.mirage.action.CLEAR_DEXKIT_CACHE" />
                <action android:name="wx.mirage.action.FORCE_RELOAD_HOOKS" />
                <action android:name="wx.mirage.action.TEMP_UNHIDE" />
                <action android:name="wx.mirage.action.RESTORE_HIDE" />
                <action android:name="wx.mirage.action.BACKGROUND_RESTORE" />
                <action android:name="wx.mirage.action.CONFIG_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ===== Xposed 模块声明 ===== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_xposed_description" />

        <meta-data
            android:name="xposed_module"
            android:value="true" />
        <meta-data
            android:name="xposed_minversion"
            android:value="82" />
        <meta-data
            android:name="xposed_scope"
            android:value="com.tencent.mm" />
        <meta-data
            android:name="xposed_description"
            android:value="@string/app_xposed_description" />

        <meta-data
            android:name="xposed_init"
            android:value="wx.mirage.wxmask.MainHook" />

    </application>
</manifest>
